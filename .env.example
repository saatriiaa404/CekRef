# Salin file ini menjadi .env lalu isi nilainya.

# Lokasi database SQLite lokal (relatif terhadap folder proyek)
DATABASE_URL="file:./dev.db"

# Email kontak untuk "polite pool" Crossref (wajib diisi email aktif)
CROSSREF_MAILTO=""

# true = hanya membaca cache, tanpa panggilan jaringan (untuk demo)
DEMO_MODE=false
